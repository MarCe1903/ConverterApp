{
  "LibreOffice": {
    "ProgramPath": "",
    "WorkingDirectory": "",
    "UserProfileDirectory": ".converter-profile-dev",
    "StartupTimeoutSeconds": 30,
    "ConversionTimeoutSeconds": 120
  },
  "Storage": {
    "InputDirectory": "temp/input",
    "OutputDirectory": "temp/output",
    "MaxFileSizeInMb": 50
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
